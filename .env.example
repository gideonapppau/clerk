# =============================================================================
# Clerk — Docker Compose Environment Variables
# Copy this file to .env and fill in values before running docker-compose up.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=clerk
POSTGRES_PASSWORD=secret
POSTGRES_DB=clerk

# --- Core (Go API) ----------------------------------------------------------
CORE_PORT=8080
DATABASE_URL=postgres://clerk:secret@postgres:5432/clerk?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string

# LLM — get keys from https://console.groq.com and https://platform.openai.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_OPENAI_MODEL=gpt-4o-mini

# Service URLs (Docker network addresses)
GATEWAY_URL=http://gateway:3000
CORE_URL=http://core:8080
APP_URL=http://localhost:3001

# Environment
CLERK_ENV=development

# Moolre (Mobile Money) — https://dashboard.moolre.com
MOOLRE_PRIVATE_KEY=your-moolre-private-key
MOOLRE_PUBLIC_KEY=your-moolre-public-key
MOOLRE_WEBHOOK_SECRET=your-moolre-webhook-secret

# Paystack — https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=your-paystack-secret-key
CLERK_PAYSTACK_PLAN_GROWTH=PLN_xxxxxxxxxxxxxxxx

# Push Notifications (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_PUBLIC_KEY=your-vapid-public-key

# Payment Recovery
PAYMENT_RECOVERY_ALL_PLANS=false
PAYMENT_RECOVERY_DELAY=30m

# Founder Dashboard
FOUNDER_HOSTING_USD_MONTH=10
FOUNDER_BSP_USD_MONTH=15

# --- Gateway (WhatsApp) -----------------------------------------------------
GATEWAY_PORT=3000
SESSION_DIR=./data/sessions
WEBHOOK_SECRET=clerk-dev-webhook

# --- Dashboard (Next.js) ----------------------------------------------------
DASHBOARD_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=local-dev-key-do-not-use-in-production=

# =============================================================================
# Clerk Core — Environment Variables
# Copy this file to .env and fill in values.
# =============================================================================

# --- Server ------------------------------------------------------------------
PORT=8080

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string
# Format: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://clerk:secret@localhost:5432/clerk?sslmode=disable

# --- Auth --------------------------------------------------------------------
# Secret key for JWT token signing (use a long random string)
JWT_SECRET=your-secret-key-here

# --- LLM (Groq / OpenAI) ----------------------------------------------------
# Primary LLM provider — get a key from https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Fallback LLM provider — get a key from https://platform.openai.com
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Model to use for chat completions (used as fallback model name)
LLM_OPENAI_MODEL=gpt-4o-mini

# --- Service URLs ------------------------------------------------------------
# WhatsApp Baileys gateway URL
GATEWAY_URL=http://localhost:3000

# This service's public URL
CORE_URL=http://localhost:8080

# Dashboard / frontend URL
APP_URL=http://localhost:3001

# --- Environment -------------------------------------------------------------
# "development" or "production" — controls sandbox modes for payment providers
CLERK_ENV=development

# --- Moolre (Mobile Money) --------------------------------------------------
# API credentials from https://dashboard.moolre.com
MOOLRE_PRIVATE_KEY=your-moolre-private-key
MOOLRE_PUBLIC_KEY=your-moolre-public-key

# Webhook secret for verifying Moolre payment callbacks
MOOLRE_WEBHOOK_SECRET=your-moolre-webhook-secret

# --- Paystack ----------------------------------------------------------------
# API secret key from https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Paystack plan code for subscription billing
CLERK_PAYSTACK_PLAN_GROWTH=PLN_xxxxxxxxxxxxxxxx

# --- Push Notifications (VAPID) ----------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_PUBLIC_KEY=your-vapid-public-key

# --- Payment Recovery --------------------------------------------------------
# Set to "true" to enable recovery for all plans (not just paid)
PAYMENT_RECOVERY_ALL_PLANS=false

# How far back to look for pending orders (e.g. "30m", "1h", "24h")
PAYMENT_RECOVERY_DELAY=30m

# --- Founder Dashboard -------------------------------------------------------
# Monthly hosting cost in USD (for unit economics)
FOUNDER_HOSTING_USD_MONTH=10

# Monthly BSP cost in USD (for unit economics)
FOUNDER_BSP_USD_MONTH=15
